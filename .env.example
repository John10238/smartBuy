# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET=

# Database (optional in AI Studio — falls back to in-memory store when unset)
DATABASE_URL=

# Safaricom M-Pesa Daraja API (optional)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Object Storage (optional — falls back to in-memory upload store when unset)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Email / SMTP for Forgot Password Reset Codes (optional — previews reset code in dev when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartBuy POS <no-reply@smartbuy.co.ke>
